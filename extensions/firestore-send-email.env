AUTH_TYPE=LOGIN
DATABASE=(default)
DATABASE_REGION=us-west3
DEFAULT_FROM=RHIVE Support <support@rhiveconstruction.com>
firebaseextensions.v1beta.function/location=us-west3
firebaseextensions.v1beta.function/minInstances=0
firebaseextensions.v1beta.function/vpcConnectorEgressSettings=VPC_CONNECTOR_EGRESS_SETTINGS_UNSPECIFIED
firebaseextensions.v1beta.v2function/memory=256Mi
MAIL_COLLECTION=mail
SMTP_CONNECTION_URI=smtps://support%40rhiveconstruction.com@smtp.gmail.com:465
TTL_EXPIRE_TYPE=never
TTL_EXPIRE_VALUE=1