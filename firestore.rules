rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // RHIVE QOS — App-managed authentication (password_hash in Firestore)
    // Firebase Auth is not used for session management, so auth token is not available.
    // All access is controlled at the application layer.

    // OTP codes — server-only (Admin SDK bypasses these rules)
    match /otp_codes/{docId} {
      allow read, write: if false;
    }

    // OTP rate limits — server-only
    match /otp_rate_limits/{docId} {
      allow read, write: if false;
    }

    // Mail queue — server-only (Trigger Email extension uses Admin SDK)
    match /mail/{docId} {
      allow read, write: if false;
    }

    // Password reset tokens — server-only
    match /passwordResets/{docId} {
      allow read, write: if false;
    }

    // Preserve interviews app rules (authenticated users / admin)
    match /interviews/{interviewId} {
      allow create: if request.auth != null &&
                    request.resource.data.timestamp is timestamp &&
                    request.resource.data.userEmail is string &&
                    request.resource.data.transcripts is list &&
                    request.resource.data.report is map;
      allow read, list: if request.auth != null &&
                        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
                         (request.auth.token.email == "sheena.l@rhiveconstruction.com" && request.auth.token.email_verified == true));
    }

    // User Activity Logs — app-layer controlled
    // Write: open to the app (session-validated at app layer)
    // Read: open to the app (role-based filtering applied in application code)
    match /user_log/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Existing open catch-all (maintained for RHIVE OS app-layer auth compatibility,
    // including mail_outbox, inbox_messages, campaign_logs, accounts, contacts, projects)
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
